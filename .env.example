DATABASE_URL=postgresql+psycopg://uto:change-me@127.0.0.1:5432/uto
APP_ORIGIN=http://127.0.0.1:5173
APP_ENV=development
DATA_DIR=./data
# Producción requiere HTTPS y SMTP. Nunca subir .env a Git.
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM, SMTP_STARTTLS=true

# Google Workspace: configurar solo en .env local o gestor de secretos del servidor.
# Sin estas dos variables, la UI informa que Google aún no está habilitado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback exacto: APP_ORIGIN + /api/v1/auth/google/callback
